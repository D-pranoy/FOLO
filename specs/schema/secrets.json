{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecretsDocument",
  "description": "secrets.json: identity keys and provider credentials. Owner-only permissions; never exported or returned by the API (docs/specs/config-model.md, docs/architecture/security.md).",
  "type": "object",
  "properties": {
    "schema_version": {"$ref": "common.json#/$defs/SchemaVersion", "default": 2},
    "revision": {"$ref": "common.json#/$defs/Revision", "default": 0},
    "server_id": {"$ref": "common.json#/$defs/ServerId", "default": ""},
    "identity": {"$ref": "#/$defs/Identity", "default": {}},
    "master_key_hash": {"type": "string", "maxLength": 128, "default": ""},
    "providers": {
      "description": "Provider instance id: its credentials.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/ProviderSecrets"},
      "default": {}
    },
    "pinned_certificates": {
      "description": "Hue bridge id (lowercase): the SHA-256 fingerprint, in lowercase hex, of the certificate a person confirmed for a bridge whose certificate doesn't chain to a Signify root (trust on first use, docs/integrations/hue.md).",
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "default": {}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Identity": {
      "description": "The node's static X25519 key pair, base64url (docs/specs/pairing-and-connect.md#identity).",
      "type": "object",
      "properties": {
        "public_key": {"type": "string", "maxLength": 64, "default": ""},
        "private_key": {"type": "string", "maxLength": 64, "default": ""}
      },
      "additionalProperties": false
    },
    "ProviderSecrets": {
      "type": "object",
      "properties": {
        "app_key": {"description": "Hue application key.", "type": "string", "maxLength": 128},
        "client_key": {"description": "Hue entertainment client key (PSK).", "type": "string", "maxLength": 128},
        "pin": {"description": "WLED settings PIN.", "type": "string", "maxLength": 16},
        "token": {"description": "Hyperion API token.", "type": "string", "maxLength": 128}
      },
      "additionalProperties": false
    }
  }
}
