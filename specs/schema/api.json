{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Api",
  "description": "Request and response bodies of the client API (docs/specs/client-api.md, specs/openapi.yaml). Documents in them are clamped as usual; these shapes aren't stored.",
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {"description": "A machine code, for example not_found.", "type": "string", "maxLength": 64},
            "message": {"type": "string", "maxLength": 1000},
            "details": {"type": "object"}
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["error"],
      "additionalProperties": false
    },
    "Health": {
      "description": "Liveness only: no configuration.",
      "type": "object",
      "properties": {"status": {"const": "ok"}},
      "required": ["status"],
      "additionalProperties": false
    },
    "ContractVersions": {
      "type": "object",
      "properties": {
        "client_api": {"type": "string", "maxLength": 32},
        "source_link": {"type": "string", "maxLength": 32},
        "config": {"type": "integer", "minimum": 2}
      },
      "required": ["client_api", "source_link", "config"],
      "additionalProperties": false
    },
    "Info": {
      "type": "object",
      "properties": {
        "id": {"description": "The node id (docs/specs/pairing-and-connect.md#identity).", "type": "string", "maxLength": 64},
        "name": {"type": "string", "maxLength": 64},
        "version": {"type": "string", "maxLength": 32},
        "role": {"enum": ["controller", "source"]},
        "contracts": {"$ref": "#/$defs/ContractVersions"},
        "capabilities": {"description": "Optional features, for example hue or screen.", "type": "array", "items": {"type": "string", "maxLength": 32}}
      },
      "required": ["id", "name", "version", "role", "contracts", "capabilities"],
      "additionalProperties": false
    },
    "State": {
      "description": "Everything a UI needs to start, in one call.",
      "type": "object",
      "properties": {
        "info": {"$ref": "#/$defs/Info"},
        "zones": {"$ref": "zones.json"},
        "show": {"$ref": "show.json"},
        "providers": {"$ref": "providers.json"},
        "sources": {"$ref": "sources.json"},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/EffectInfo"}},
        "system": {"$ref": "#/$defs/SystemSettings"}
      },
      "required": ["info", "zones", "show", "providers", "sources", "effects", "system"],
      "additionalProperties": false
    },
    "EffectInfo": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 64},
        "version": {"type": "string", "maxLength": 32},
        "name": {"type": "string", "maxLength": 64},
        "description": {"type": "string", "maxLength": 500},
        "inputs": {"description": "Inputs it reads: audio, beat, media, screen, generator.", "type": "array", "items": {"type": "string", "maxLength": 32}},
        "params_schema": {"description": "JSON Schema of its parameters; the UI's inspector is built from it.", "type": "object"},
        "min_elements": {"type": "integer", "minimum": 1}
      },
      "required": ["id", "version", "name", "inputs", "params_schema", "min_elements"],
      "additionalProperties": false
    },
    "ZoneActivation": {
      "type": "object",
      "properties": {
        "zone": {"type": "string", "maxLength": 64},
        "active": {"type": "boolean"},
        "conflicts": {"description": "Active zones that share targets with it; activating asks before taking them over.", "type": "array", "items": {"type": "string", "maxLength": 64}}
      },
      "required": ["zone", "active", "conflicts"],
      "additionalProperties": false
    },
    "ActivateRequest": {
      "type": "object",
      "properties": {
        "take_over": {"description": "Take shared targets from the zones that drive them.", "type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "TestRequest": {
      "type": "object",
      "properties": {
        "pattern": {"enum": ["identify", "sweep", "position"], "default": "identify"},
        "target": {"description": "A target id; empty for all of the zone's targets.", "type": "string", "maxLength": 64, "default": ""},
        "seconds": {"type": "number", "minimum": 1, "maximum": 60, "default": 5}
      },
      "additionalProperties": false
    },
    "SceneApplyRequest": {
      "type": "object",
      "properties": {
        "zone": {"type": "string", "maxLength": 64},
        "roles": {"description": "Role: surface id, overriding the automatic match and remembered for this scene and zone; an empty string returns the role to automatic (ADR-0038 D12, D13).", "type": "object", "propertyNames": {"maxLength": 64}, "maxProperties": 64, "additionalProperties": {"type": "string", "maxLength": 64}, "default": {}},
        "keep_changes": {"description": "Merge into the zone's active scene, keeping what the user changed since it was applied (ADR-0038 D15).", "type": "boolean", "default": false}
      },
      "required": ["zone"],
      "additionalProperties": false
    },
    "ApplyResult": {
      "description": "What an apply did in one zone.",
      "type": "object",
      "properties": {
        "zone": {"type": "string", "maxLength": 64},
        "scene": {"description": "The id of the scene the zone now has active.", "type": "string", "maxLength": 64},
        "roles": {"description": "Each bound role of the applied scene: the surface it went to.", "type": "object", "additionalProperties": {"type": "string", "maxLength": 64}},
        "skipped": {"description": "Roles no surface of the zone could take.", "type": "array", "items": {"type": "string", "maxLength": 64}, "maxItems": 64}
      },
      "required": ["zone", "scene", "roles", "skipped"],
      "additionalProperties": false
    },
    "SceneApplied": {
      "type": "object",
      "properties": {
        "show": {"$ref": "show.json"},
        "results": {"type": "array", "items": {"$ref": "#/$defs/ApplyResult"}, "maxItems": 256}
      },
      "required": ["show", "results"],
      "additionalProperties": false
    },
    "ShowResetRequest": {
      "description": "Reset all: the zones to reset; empty for every zone (ADR-0038 D21).",
      "type": "object",
      "properties": {
        "zones": {"type": "array", "items": {"type": "string", "maxLength": 64}, "maxItems": 256, "default": []}
      },
      "additionalProperties": false
    },
    "DiscoverRequest": {
      "type": "object",
      "properties": {
        "kinds": {"type": "array", "items": {"enum": ["hyperion", "wled", "hue"]}, "default": ["hyperion", "wled", "hue"]}
      },
      "additionalProperties": false
    },
    "DiscoveredDevice": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["hyperion", "wled", "hue"]},
        "id": {"type": "string", "maxLength": 64},
        "name": {"type": "string", "maxLength": 64},
        "address": {"type": "string", "maxLength": 255}
      },
      "required": ["kind", "id", "name", "address"],
      "additionalProperties": false
    },
    "HuePairing": {
      "description": "Progress of the link-button pairing.",
      "type": "object",
      "properties": {
        "state": {"enum": ["waiting", "paired", "failed", "timeout"]},
        "message": {"type": "string", "maxLength": 500}
      },
      "required": ["state", "message"],
      "additionalProperties": false
    },
    "InputList": {
      "description": "The inputs available on a source.",
      "type": "object",
      "properties": {
        "default_output": {"type": "string", "maxLength": 300},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/AudioDevice"}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/AudioDevice"}},
        "apps": {"type": "array", "items": {"$ref": "#/$defs/AudioApp"}},
        "screens": {"type": "array", "items": {"$ref": "#/$defs/Screen"}},
        "media": {"description": "Whether now playing can be read on this source.", "type": "boolean"}
      },
      "required": ["default_output", "outputs", "inputs", "apps", "screens", "media"],
      "additionalProperties": false
    },
    "AudioDevice": {
      "type": "object",
      "properties": {"name": {"type": "string", "maxLength": 300}},
      "required": ["name"],
      "additionalProperties": false
    },
    "AudioApp": {
      "type": "object",
      "properties": {
        "exe": {"type": "string", "maxLength": 260},
        "name": {"type": "string", "maxLength": 260},
        "active": {"description": "Playing audio right now.", "type": "boolean"},
        "peak": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": ["exe", "name", "active", "peak"],
      "additionalProperties": false
    },
    "Screen": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 128},
        "name": {"type": "string", "maxLength": 128},
        "width": {"description": "In pixels; 0 while it isn't known (the Linux portal entry, before the user has chosen a screen).", "type": "integer", "minimum": 0},
        "height": {"description": "In pixels; 0 while it isn't known.", "type": "integer", "minimum": 0},
        "primary": {"type": "boolean"}
      },
      "required": ["id", "name", "width", "height", "primary"],
      "additionalProperties": false
    },
    "MediaState": {
      "description": "Now playing on a source.",
      "type": "object",
      "properties": {
        "state": {"enum": ["off", "unavailable", "error", "none", "playing", "paused", "stopped"]},
        "app": {"type": "string", "maxLength": 260},
        "title": {"type": "string", "maxLength": 500},
        "artist": {"type": "string", "maxLength": 500},
        "album": {"type": "string", "maxLength": 500},
        "art": {"description": "Album art id, 0 without art. Clients add it to the art URL to bust caches.", "type": "integer", "minimum": 0},
        "colors": {"description": "Up to five colours picked from the art.", "type": "array", "items": {"$ref": "common.json#/$defs/Color"}, "maxItems": 5}
      },
      "required": ["state", "app", "title", "artist", "album", "art", "colors"],
      "additionalProperties": false
    },
    "MediaControl": {
      "type": "object",
      "properties": {"action": {"enum": ["play_pause", "next", "previous"]}},
      "required": ["action"],
      "additionalProperties": false
    },
    "InviteRequest": {
      "type": "object",
      "properties": {
        "uses": {"description": "More than 1 only for handover invites.", "type": "integer", "minimum": 1, "maximum": 64, "default": 1},
        "ttl_s": {"type": "integer", "minimum": 60, "maximum": 86400, "default": 600}
      },
      "additionalProperties": false
    },
    "Invite": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 64},
        "code": {"description": "folo://join?... (docs/specs/pairing-and-connect.md#source-invite).", "type": "string", "maxLength": 2048},
        "expires": {"description": "Unix seconds.", "type": "integer", "minimum": 0}
      },
      "required": ["id", "code", "expires"],
      "additionalProperties": false
    },
    "NodeSummary": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 64},
        "name": {"type": "string", "maxLength": 64},
        "version": {"type": "string", "maxLength": 32},
        "platform": {"type": "string", "maxLength": 64}
      },
      "required": ["id", "name", "version", "platform"],
      "additionalProperties": false
    },
    "JoinRequest": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 64},
        "node": {"$ref": "#/$defs/NodeSummary"},
        "verification_code": {"description": "6 digits, also shown on the source.", "type": "string", "pattern": "^[0-9]{6}$"},
        "expires": {"type": "integer", "minimum": 0}
      },
      "required": ["id", "node", "verification_code", "expires"],
      "additionalProperties": false
    },
    "ClientRequest": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "maxLength": 64},
        "scope": {"enum": ["control", "admin"], "default": "control"}
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "ClientInfo": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 64},
        "name": {"type": "string", "maxLength": 64},
        "scope": {"enum": ["control", "admin"]},
        "created": {"type": "integer", "minimum": 0},
        "last_used": {"type": "integer", "minimum": 0}
      },
      "required": ["id", "name", "scope", "created", "last_used"],
      "additionalProperties": false
    },
    "IssuedClient": {
      "description": "Shown once: the key isn't stored.",
      "type": "object",
      "properties": {
        "client": {"$ref": "#/$defs/ClientInfo"},
        "key": {"description": "folo_c_ + 32 random bytes, base64url.", "type": "string", "pattern": "^folo_c_[A-Za-z0-9_-]{43}$"},
        "connect_code": {"description": "folo://connect?... (docs/specs/pairing-and-connect.md#client-connect-code).", "type": "string", "maxLength": 2048}
      },
      "required": ["client", "key", "connect_code"],
      "additionalProperties": false
    },
    "PackInfo": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 65},
        "version": {"type": "string", "maxLength": 32},
        "name": {"type": "string", "maxLength": 64},
        "description": {"type": "string", "maxLength": 500},
        "builtin": {"description": "folo/core, folo/genres and folo/effects ship with the node and can't be removed.", "type": "boolean"},
        "editable": {"description": "A local pack (author local), whose items can be written.", "type": "boolean"},
        "items": {"type": "integer", "minimum": 0, "maximum": 500},
        "hash": {"description": "SHA-256 (hex) of the pack's canonical .folopack (ADR-0038 D9).", "type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["id", "version", "name", "description", "builtin", "editable", "items", "hash"],
      "additionalProperties": false
    },
    "ItemType": {
      "description": "A pack item type, as its folder is named.",
      "enum": ["palettes", "reactions", "looks", "scenes", "zone-templates"]
    },
    "LibraryItem": {
      "description": "An item of an installed pack, for the gallery.",
      "type": "object",
      "properties": {
        "ref": {"description": "author/pack:item.", "type": "string", "maxLength": 130},
        "pack": {"type": "string", "maxLength": 65},
        "version": {"description": "The pack's version.", "type": "string", "maxLength": 32},
        "type": {"$ref": "#/$defs/ItemType"},
        "hash": {"description": "SHA-256 (hex) of the item's file, as provenance records it.", "type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preview": {"description": "The preview's path under /library/packs/{pack}/previews/, or empty.", "type": "string", "maxLength": 255},
        "item": {"description": "The item, as clamped (pack.json's item of this type).", "type": "object"}
      },
      "required": ["ref", "pack", "version", "type", "hash", "preview", "item"],
      "additionalProperties": false
    },
    "BackupManifest": {
      "description": "folo-backup.json, the manifest of a backup archive (ADR-0038 D25).",
      "type": "object",
      "properties": {
        "format": {"description": "1; a newer format is refused with 422 incompatible.", "type": "integer", "minimum": 1},
        "created": {"description": "Unix seconds.", "type": "integer", "minimum": 0},
        "node_version": {"type": "string", "maxLength": 32},
        "schema_version": {"description": "The documents' schema_version; a newer one than the node reads is refused with 422 incompatible.", "type": "integer", "minimum": 2},
        "files": {
          "description": "path: SHA-256 (hex) of every other file in the archive.",
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "required": ["format", "created", "node_version", "schema_version", "files"],
      "additionalProperties": false
    },
    "UpdateStatus": {
      "type": "object",
      "properties": {
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/NodeUpdate"}}
      },
      "required": ["nodes"],
      "additionalProperties": false
    },
    "NodeUpdate": {
      "type": "object",
      "properties": {
        "node": {"type": "string", "maxLength": 64},
        "role": {"enum": ["controller", "source"]},
        "current": {"type": "string", "maxLength": 32},
        "available": {"description": "Empty when up to date.", "type": "string", "maxLength": 32},
        "state": {"enum": ["idle", "available", "downloading", "ready", "installing", "failed"]},
        "approved": {"type": "boolean"}
      },
      "required": ["node", "role", "current", "available", "state", "approved"],
      "additionalProperties": false
    },
    "UpdatePolicy": {
      "type": "object",
      "properties": {
        "channel": {"enum": ["stable", "beta"], "default": "stable"},
        "mode": {"description": "What happens when an update is found.", "enum": ["notify", "approve", "automatic"], "default": "approve"}
      },
      "additionalProperties": false
    },
    "SystemSettings": {
      "type": "object",
      "properties": {
        "remote_access": {"$ref": "node.json#/$defs/RemoteAccess"},
        "start_at_sign_in": {"description": "Loopback only.", "type": "boolean"},
        "service": {"$ref": "#/$defs/ServiceStatus"}
      },
      "required": ["remote_access", "start_at_sign_in", "service"],
      "additionalProperties": false
    },
    "ServiceStatus": {
      "description": "Loopback only.",
      "type": "object",
      "properties": {
        "installed": {"type": "boolean"},
        "running": {"type": "boolean"}
      },
      "required": ["installed", "running"],
      "additionalProperties": false
    },
    "NodeStatus": {
      "description": "What `folo status --json` prints (docs/architecture/control-plane.md#status-and-health). Loopback only.",
      "type": "object",
      "properties": {
        "running": {"description": "Whether a node runs on this home: always true from the API, false when `folo status` reports from the files.", "type": "boolean"},
        "id": {"description": "The node id (docs/specs/pairing-and-connect.md#identity); empty until the node first ran.", "type": "string", "maxLength": 64},
        "version": {"type": "string", "maxLength": 32},
        "role": {"enum": ["controller", "source"]},
        "launch": {"description": "managed: started by the desktop app.", "enum": ["managed", "foreground"]},
        "mode": {"description": "The launch that chose the folders (docs/architecture/control-plane.md#folders): custom for --home or FOLO_HOME.", "enum": ["custom", "portable", "service", "user"]},
        "home": {"description": "The folder holding node.toml.", "type": "string", "maxLength": 4096},
        "data": {"description": "The folder holding the documents.", "type": "string", "maxLength": 4096},
        "log": {"description": "The log file.", "type": "string", "maxLength": 4096},
        "listen": {"description": "The address and port the node listens on, or would listen on.", "$ref": "node.json#/$defs/Listen"},
        "overrides": {"description": "The deployment overrides, with their sources.", "type": "array", "items": {"$ref": "#/$defs/NodeOverride"}, "maxItems": 64},
        "pairing": {"$ref": "#/$defs/PairingStatus"},
        "workers": {"description": "Worker name (folo-source, folo-capture): its state.", "type": "object", "additionalProperties": {"$ref": "#/$defs/WorkerStatus"}},
        "providers": {"type": "array", "items": {"$ref": "#/$defs/ProviderStatus"}, "maxItems": 256}
      },
      "required": ["running", "id", "version", "role", "launch", "mode", "home", "data", "log", "listen", "overrides", "pairing", "workers", "providers"],
      "additionalProperties": false
    },
    "NodeOverride": {
      "description": "A setting given by a FOLO_* variable or a flag (docs/architecture/control-plane.md#settings-layering).",
      "type": "object",
      "properties": {
        "setting": {"description": "The setting's path in node.toml, for example listen.port.", "type": "string", "maxLength": 64},
        "source": {"enum": ["environment", "flag"]},
        "name": {"description": "The variable or the flag, for example FOLO_LISTEN_PORT or --port.", "type": "string", "maxLength": 64},
        "value": {"description": "The value it gives the setting."}
      },
      "required": ["setting", "source", "name", "value"],
      "additionalProperties": false
    },
    "PairingStatus": {
      "type": "object",
      "properties": {
        "owner": {"description": "In the source role, the owner controller's id; empty while unpaired and in the controller role.", "type": "string", "maxLength": 64},
        "sources": {"description": "In the controller role, the paired sources besides the local one.", "type": "integer", "minimum": 0}
      },
      "required": ["owner", "sources"],
      "additionalProperties": false
    },
    "WorkerStatus": {
      "type": "object",
      "properties": {
        "state": {"enum": ["starting", "running", "stopped", "failed"]},
        "pid": {"description": "Its process id; 0 while it isn't running.", "type": "integer", "minimum": 0},
        "restarts": {"description": "How often it was started again since the node started.", "type": "integer", "minimum": 0}
      },
      "required": ["state", "pid", "restarts"],
      "additionalProperties": false
    },
    "ProviderStatus": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 64},
        "kind": {"enum": ["hyperion", "wled", "hue"]},
        "enabled": {"type": "boolean"},
        "state": {"enum": ["stopped", "connecting", "connected", "error"]}
      },
      "required": ["id", "kind", "enabled", "state"],
      "additionalProperties": false
    },
    "ReloadResult": {
      "description": "What `folo reload` applied (docs/architecture/control-plane.md#settings-layering).",
      "type": "object",
      "properties": {
        "applied": {"description": "Settings and documents applied while running.", "type": "array", "items": {"type": "string", "maxLength": 64}},
        "restart_required": {"description": "Changed settings that take effect after a restart.", "type": "array", "items": {"type": "string", "maxLength": 64}}
      },
      "required": ["applied", "restart_required"],
      "additionalProperties": false
    },
    "LogLines": {
      "type": "object",
      "properties": {
        "lines": {"type": "array", "items": {"$ref": "#/$defs/LogLine"}}
      },
      "required": ["lines"],
      "additionalProperties": false
    },
    "LogLine": {
      "type": "object",
      "properties": {
        "time_ms": {"description": "Unix milliseconds.", "type": "integer", "minimum": 0},
        "level": {"enum": ["error", "warn", "info", "debug", "trace"]},
        "source": {"description": "node, or a source id or worker.", "type": "string", "maxLength": 64},
        "message": {"type": "string", "maxLength": 10000}
      },
      "required": ["time_ms", "level", "source", "message"],
      "additionalProperties": false
    },
    "LoginRequest": {
      "type": "object",
      "properties": {"key": {"type": "string", "maxLength": 128}},
      "required": ["key"],
      "additionalProperties": false
    },
    "AuthRequest": {
      "description": "Approval-based client pairing (docs/specs/pairing-and-connect.md#approval-based-client-pairing).",
      "type": "object",
      "properties": {
        "name": {"type": "string", "maxLength": 64},
        "request_id": {"description": "Random, shown to the client's user.", "type": "string", "maxLength": 64}
      },
      "required": ["name", "request_id"],
      "additionalProperties": false
    },
    "AuthResult": {
      "type": "object",
      "properties": {
        "state": {"enum": ["pending", "approved", "rejected", "expired"]},
        "key": {"description": "Only when approved.", "type": "string", "maxLength": 128}
      },
      "required": ["state"],
      "additionalProperties": false
    }
  }
}
