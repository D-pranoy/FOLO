{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientsDocument",
  "description": "clients.json: client keys, stored hashed (docs/specs/config-model.md, docs/specs/pairing-and-connect.md).",
  "type": "object",
  "properties": {
    "schema_version": {"$ref": "common.json#/$defs/SchemaVersion", "default": 2},
    "revision": {"$ref": "common.json#/$defs/Revision", "default": 0},
    "server_id": {"$ref": "common.json#/$defs/ServerId", "default": ""},
    "clients": {"type": "array", "items": {"$ref": "#/$defs/Client"}, "maxItems": 256, "default": []}
  },
  "additionalProperties": false,
  "$defs": {
    "Client": {
      "type": "object",
      "properties": {
        "id": {"$ref": "common.json#/$defs/Id", "default": ""},
        "name": {"$ref": "common.json#/$defs/Name", "default": "Client"},
        "scope": {"enum": ["control", "admin"], "default": "control"},
        "key_hash": {"description": "The client key's hash; the key itself is never stored.", "type": "string", "maxLength": 128, "default": ""},
        "created": {"description": "Unix seconds.", "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0},
        "last_used": {"description": "Unix seconds; 0 for never.", "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0}
      },
      "additionalProperties": false
    }
  }
}
