{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common",
  "description": "Definitions shared by FOLO's documents (docs/specs/config-model.md). The x-folo-* keywords drive the clampers (docs/specs/config-model.md#clamping-rules).",
  "$defs": {
    "Id": {
      "description": "An id of 1-64 characters. Missing, empty or duplicate ids get a new one (8 lowercase hex characters).",
      "type": "string",
      "maxLength": 64,
      "default": "",
      "x-folo-id": true
    },
    "Ref": {
      "description": "The id of another entity; empty for none.",
      "type": "string",
      "maxLength": 64
    },
    "Name": {
      "type": "string",
      "maxLength": 64
    },
    "Color": {
      "description": "#RRGGBB, upper-cased when clamped.",
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "x-folo-color": true
    },
    "Palette": {
      "type": "array",
      "items": {"$ref": "#/$defs/Color"},
      "minItems": 1,
      "maxItems": 16
    },
    "Tags": {
      "type": "array",
      "items": {"type": "string", "maxLength": 24},
      "maxItems": 16
    },
    "Vec3": {
      "description": "A position or vector in a zone, metres: x right, y forward, z up.",
      "type": "object",
      "properties": {
        "x": {"type": "number", "minimum": -1000, "maximum": 1000, "default": 0},
        "y": {"type": "number", "minimum": -1000, "maximum": 1000, "default": 0},
        "z": {"type": "number", "minimum": -1000, "maximum": 1000, "default": 0}
      },
      "additionalProperties": false
    },
    "Orientation": {
      "description": "Degrees.",
      "type": "object",
      "properties": {
        "yaw": {"type": "number", "minimum": -180, "maximum": 180, "default": 0},
        "pitch": {"type": "number", "minimum": -180, "maximum": 180, "default": 0},
        "roll": {"type": "number", "minimum": -180, "maximum": 180, "default": 0}
      },
      "additionalProperties": false
    },
    "Plane": {
      "description": "A rectangle in a zone: an origin corner and the u (width) and v (height) edge vectors.",
      "type": "object",
      "properties": {
        "origin": {"$ref": "#/$defs/Vec3", "default": {}},
        "u": {"$ref": "#/$defs/Vec3", "default": {"x": 1}},
        "v": {"$ref": "#/$defs/Vec3", "default": {"z": 1}}
      },
      "additionalProperties": false
    },
    "Span": {
      "description": "A run of cells or elements.",
      "type": "object",
      "properties": {
        "start": {"type": "integer", "minimum": 0, "maximum": 65535, "default": 0},
        "count": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 1}
      },
      "additionalProperties": false
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "default": 0
    },
    "SchemaVersion": {
      "description": "The document format version. A newer one than the reader knows is a structural error.",
      "type": "integer",
      "minimum": 2,
      "maximum": 2,
      "default": 2
    },
    "ServerId": {
      "description": "Changes when the controller starts, so clients notice a restart.",
      "type": "string",
      "maxLength": 64,
      "default": ""
    }
  }
}
