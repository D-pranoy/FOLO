{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShowDocument",
  "description": "show.json: the active scene per zone, the scenes with their layers, and the default scene (docs/specs/config-model.md, docs/architecture/content.md).",
  "type": "object",
  "properties": {
    "schema_version": {"$ref": "common.json#/$defs/SchemaVersion", "default": 2},
    "revision": {"$ref": "common.json#/$defs/Revision", "default": 0},
    "server_id": {"$ref": "common.json#/$defs/ServerId", "default": ""},
    "active": {
      "description": "Zone id: scene id.",
      "type": "object",
      "additionalProperties": {"$ref": "common.json#/$defs/Ref"},
      "default": {}
    },
    "default_scene": {
      "description": "What Reset all applies: a pack item (author/pack:item), a built-in id (fx:*, genre:*) resolved through the alias table, or a bare id (a scene of this document, else an item of local/my-presets); empty for folo/core:default (ADR-0038 D19, D21).",
      "type": "string",
      "maxLength": 130,
      "default": ""
    },
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/Scene"}, "maxItems": 256, "default": []},
    "bindings": {
      "description": "Remembered role overrides per zone and scene (ADR-0038 D13).",
      "type": "array",
      "items": {"$ref": "#/$defs/RoleBinding"},
      "maxItems": 256
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Scene": {
      "type": "object",
      "properties": {
        "id": {"$ref": "common.json#/$defs/Id", "default": ""},
        "name": {"type": "string", "maxLength": 40, "default": "Scene"},
        "tags": {"$ref": "common.json#/$defs/Tags", "default": []},
        "provenance": {"$ref": "#/$defs/Provenance"},
        "layers_by_role": {
          "description": "Surface role (strip.main, canvas.room, ...): its layers, bottom first.",
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/Layer"}, "maxItems": 64},
          "default": {}
        },
        "macros": {"type": "array", "items": {"$ref": "#/$defs/Macro"}, "maxItems": 8, "default": []}
      },
      "additionalProperties": false
    },
    "Provenance": {
      "description": "Where an applied scene came from (ADR-0038 D11).",
      "type": "object",
      "properties": {
        "pack": {"type": "string", "maxLength": 65, "default": ""},
        "version": {"type": "string", "maxLength": 32, "default": ""},
        "item": {"type": "string", "maxLength": 64, "default": ""},
        "hash": {"description": "SHA-256 (hex) of the item's file as applied; absent when unknown.", "type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "RoleBinding": {
      "description": "The surfaces a user chose for a scene's roles in a zone.",
      "type": "object",
      "properties": {
        "zone": {"$ref": "common.json#/$defs/Ref", "default": ""},
        "scene": {"description": "The scene's reference as resolved: author/pack:item, or a scene id of this document.", "type": "string", "maxLength": 130, "default": ""},
        "roles": {
          "description": "Role: surface id.",
          "type": "object",
          "additionalProperties": {"$ref": "common.json#/$defs/Ref"},
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "Macro": {
      "description": "A knob that drives parameters of several layers.",
      "type": "object",
      "properties": {
        "id": {"$ref": "common.json#/$defs/Id", "default": ""},
        "name": {"type": "string", "maxLength": 24, "default": "Macro"},
        "value": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/MacroTarget"}, "maxItems": 16, "default": []}
      },
      "additionalProperties": false
    },
    "MacroTarget": {
      "type": "object",
      "properties": {
        "layer": {"$ref": "common.json#/$defs/Ref", "default": ""},
        "param": {"type": "string", "maxLength": 64, "default": ""},
        "min": {"type": "number", "minimum": -1000000, "maximum": 1000000, "default": 0},
        "max": {"type": "number", "minimum": -1000000, "maximum": 1000000, "default": 1}
      },
      "additionalProperties": false
    },
    "Layer": {
      "type": "object",
      "properties": {
        "id": {"$ref": "common.json#/$defs/Id", "default": ""},
        "name": {"type": "string", "maxLength": 40, "default": "Layer"},
        "effect": {"$ref": "#/$defs/EffectRef", "default": {}},
        "params": {
          "description": "The effect's parameters, clamped with its parameter schema when the effect is known.",
          "type": "object",
          "default": {},
          "x-folo-params-by-effect": {"audio-visualizer": "#/$defs/AudioVisualizerParams", "brightness": "#/$defs/BrightnessParams", "mirror": "#/$defs/MirrorParams", "blur": "#/$defs/BlurParams", "trail": "#/$defs/TrailParams", "screen": "#/$defs/ScreenParams"},
          "x-folo-effects": {
            "audio-visualizer": {"version": "1.0.0", "name": "Audio visualizer", "description": "A frequency band of the audio, shaped and smoothed, in one of ten modes.", "inputs": ["audio", "beat", "media"], "min_elements": 1},
            "brightness": {"version": "1.0.0", "name": "Brightness", "description": "Scales the colours below it, and their saturation around their luma.", "inputs": [], "min_elements": 1},
            "mirror": {"version": "1.0.0", "name": "Mirror", "description": "Copies one half of what is below it, reversed, onto the other half.", "inputs": [], "min_elements": 1},
            "blur": {"version": "1.0.0", "name": "Blur", "description": "Averages each cell of what is below it with its neighbours.", "inputs": [], "min_elements": 1},
            "trail": {"version": "1.0.0", "name": "Trail", "description": "An afterglow: what is below it fades out instead of going dark at once.", "inputs": [], "min_elements": 1},
            "screen": {"version": "1.0.0", "name": "Screen", "description": "The picture of a captured screen, without its black bars, as a canvas.", "inputs": ["screen"], "min_elements": 1}
          }
        },
        "region": {"$ref": "#/$defs/Region", "default": {"kind": "relative"}},
        "blend": {"enum": ["max", "add", "alpha", "multiply"], "default": "max"},
        "axis": {"enum": ["linear_x", "linear_y", "radial", "angular"], "default": "linear_x"},
        "enabled": {"type": "boolean", "default": true},
        "solo": {"type": "boolean", "default": false},
        "lane": {"type": "integer", "minimum": -1, "maximum": 15, "default": -1}
      },
      "additionalProperties": false
    },
    "EffectRef": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 64, "default": "audio-visualizer"},
        "version": {"type": "string", "maxLength": 32, "default": "1.0.0"}
      },
      "additionalProperties": false
    },
    "Region": {
      "description": "Where a layer sits on its surface.",
      "oneOf": [
        {"$ref": "#/$defs/CellsRegion"},
        {"$ref": "#/$defs/RelativeRegion"},
        {"$ref": "#/$defs/RectRegion"}
      ],
      "default": {"kind": "relative"}
    },
    "CellsRegion": {
      "description": "Absolute cells start-end (inclusive) of a strip.",
      "type": "object",
      "properties": {
        "kind": {"const": "cells"},
        "start": {"type": "integer", "minimum": 0, "maximum": 1999, "default": 0},
        "end": {"type": "integer", "minimum": 0, "maximum": 1999, "default": 1999}
      },
      "required": ["kind"],
      "additionalProperties": false,
      "x-folo-rules": ["range"]
    },
    "RelativeRegion": {
      "description": "start-end along a strip, 0-1 of its length. snap: cover takes every cell the range touches; nearest rounds both ends to the nearest cell, halves up, as the studio's built-in builders do (docs/architecture/pipeline.md, ADR-0038 D14).",
      "type": "object",
      "properties": {
        "kind": {"const": "relative"},
        "start": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "end": {"type": "number", "minimum": 0, "maximum": 1, "default": 1},
        "snap": {"description": "Absent means cover.", "enum": ["cover", "nearest"]}
      },
      "required": ["kind"],
      "additionalProperties": false,
      "x-folo-rules": ["range"]
    },
    "RectRegion": {
      "description": "A rectangle of a canvas, 0-1 of its width and height.",
      "type": "object",
      "properties": {
        "kind": {"const": "rect"},
        "x": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "y": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "width": {"type": "number", "minimum": 0, "maximum": 1, "default": 1},
        "height": {"type": "number", "minimum": 0, "maximum": 1, "default": 1}
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "BrightnessParams": {
      "description": "The brightness post-processing effect: saturation around each cell's luma, then a multiplier.",
      "type": "object",
      "properties": {
        "brightness": {"type": "number", "minimum": 0, "maximum": 4, "default": 1},
        "saturation": {"type": "number", "minimum": 0, "maximum": 4, "default": 1}
      },
      "additionalProperties": false
    },
    "MirrorParams": {
      "description": "The mirror post-processing effect: the half it keeps is copied, reversed, onto the other.",
      "type": "object",
      "properties": {
        "keep": {"enum": ["first", "second"], "default": "first"}
      },
      "additionalProperties": false
    },
    "BlurParams": {
      "description": "The blur post-processing effect: a box blur, in cells on each side.",
      "type": "object",
      "properties": {
        "radius": {"type": "integer", "minimum": 1, "maximum": 16, "default": 1}
      },
      "additionalProperties": false
    },
    "TrailParams": {
      "description": "The trail post-processing effect: an afterglow fading with this time constant, in ms.",
      "type": "object",
      "properties": {
        "fade": {"type": "integer", "minimum": 10, "maximum": 5000, "default": 300}
      },
      "additionalProperties": false
    },
    "ScreenParams": {
      "description": "The screen effect: what the capture agent's frames show, cropped, sampled onto the layer's region of a canvas, coloured and smoothed. On a strip it draws nothing.",
      "type": "object",
      "properties": {
        "mode": {"description": "area: the whole picture. edge: the picture's border, spread inward.", "enum": ["area", "edge"], "default": "area"},
        "edge_depth": {"description": "How deep the border reaches into the picture in edge mode, as a share of its width and height.", "type": "number", "minimum": 0.02, "maximum": 0.5, "default": 0.15},
        "margins": {"description": "The shares of the picture to leave out at each side, after the black bars.", "$ref": "#/$defs/ScreenMargins", "default": {}},
        "brightness": {"type": "number", "minimum": 0, "maximum": 4, "default": 1},
        "saturation": {"type": "number", "minimum": 0, "maximum": 4, "default": 1},
        "smoothing": {"description": "The time constant of the smoothing, ms; 0 shows each frame as it is.", "type": "number", "minimum": 0, "maximum": 2000, "default": 150},
        "bars": {"description": "follow: leave out the black bars the capture agent found. ignore: use the whole picture.", "enum": ["follow", "ignore"], "default": "follow"}
      },
      "additionalProperties": false
    },
    "ScreenMargins": {
      "type": "object",
      "properties": {
        "top": {"type": "number", "minimum": 0, "maximum": 0.45, "default": 0},
        "bottom": {"type": "number", "minimum": 0, "maximum": 0.45, "default": 0},
        "left": {"type": "number", "minimum": 0, "maximum": 0.45, "default": 0},
        "right": {"type": "number", "minimum": 0, "maximum": 0.45, "default": 0}
      },
      "additionalProperties": false
    },
    "AudioVisualizerParams": {
      "description": "The audio-visualizer effect's parameters: today's segment fields, unchanged. threshold and ceiling show the widest range here; the thresholds rule applies the limits of the trigger.",
      "type": "object",
      "properties": {
        "freq_lo": {"type": "number", "minimum": 10, "maximum": 24000, "default": 60, "x-folo-decimals": 2},
        "freq_hi": {"type": "number", "minimum": 10, "maximum": 24000, "default": 250, "x-folo-decimals": 2},
        "trigger": {"enum": ["level", "hits", "beat"], "default": "level"},
        "beats": {"enum": [0.5, 1, 2, 4], "default": 1},
        "threshold": {"type": "number", "minimum": -120, "maximum": 39, "default": -60, "x-folo-decimals": 1},
        "ceiling": {"type": "number", "minimum": -119, "maximum": 40, "default": -25, "x-folo-decimals": 1},
        "gain": {"type": "number", "minimum": 0.1, "maximum": 8, "default": 1},
        "curve": {"type": "number", "minimum": 0.2, "maximum": 5, "default": 1},
        "attack": {"type": "number", "minimum": 0, "maximum": 2000, "default": 15},
        "release": {"type": "number", "minimum": 0, "maximum": 5000, "default": 200},
        "floor": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "mode": {"enum": ["fill", "pulse", "spectrum", "shift", "scroll", "drops", "scan", "wipe", "flow", "fire"], "default": "fill"},
        "direction": {"enum": ["forward", "reverse", "center", "edges"], "default": "forward"},
        "speed": {"type": "number", "minimum": 0, "maximum": 2000, "default": 120},
        "width": {"type": "number", "minimum": 1, "maximum": 100, "default": 20},
        "peak": {"type": "boolean", "default": false},
        "palette": {"$ref": "common.json#/$defs/Palette", "default": ["#FFFFFF"]}
      },
      "additionalProperties": false,
      "x-folo-rules": ["band", "thresholds"],
      "x-folo-band": {"low": "freq_lo", "high": "freq_hi", "ratio": 1.01},
      "x-folo-thresholds": {
        "trigger": "trigger",
        "by_trigger": {
          "hits": {"threshold": {"minimum": 0, "maximum": 39, "default": 3}, "ceiling": {"minimum": 1, "maximum": 40, "default": 10}}
        },
        "otherwise": {"threshold": {"minimum": -120, "maximum": -1, "default": -60}, "ceiling": {"minimum": -119, "maximum": 0, "default": -25}},
        "gap": 1
      }
    }
  }
}
